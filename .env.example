# Copy to .env for local use. Never put real values in this file: it is committed to Git.

# Contact form (Vercel serverless function /api/contact)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Google reCAPTCHA v3
# The site key is public and is built into the browser bundle. The secret key is server-only.
# Never give the secret key a VITE_ prefix.
VITE_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# Lowest score (0.0 to 1.0) accepted as human. 0.5 is a starting point to tune from real traffic.
RECAPTCHA_MIN_SCORE=0.5
RECAPTCHA_EXPECTED_ACTION=contact_submit
# Exact hostnames that may submit, comma separated, no scheme or path.
# Example: yourdomain.com,www.yourdomain.com,your-project.vercel.app,localhost
RECAPTCHA_ALLOWED_HOSTNAMES=

# Optional but recommended: durable, shared rate limiting through Upstash Redis REST
# (otherwise a best-effort per-instance counter is used).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
